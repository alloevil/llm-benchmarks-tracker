{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alloevil.github.io/llm-benchmarks-tracker/schema/evaluator.schema.json",
  "title": "Evaluator",
  "description": "A framework that runs benchmarks, a leaderboard that publishes scores, an organisation that independently re-runs evaluations, or an aggregator that collects reported numbers. File name must equal `id`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "kind", "maintainer", "released", "description", "status", "links"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 40 },
    "name": { "type": "string", "minLength": 2, "maxLength": 60 },
    "kind": {
      "description": "framework = code you run; leaderboard = maintainer-run ranking; independent-evaluator = third party that re-runs models under its own conditions; aggregator = republishes reported numbers.",
      "enum": ["framework", "leaderboard", "independent-evaluator", "aggregator"]
    },
    "maintainer": { "type": "string", "minLength": 2, "maxLength": 120 },
    "released": { "type": "string", "pattern": "^(19|20)[0-9]{2}-(0[1-9]|1[0-2])$" },
    "description": { "type": "string", "minLength": 60, "maxLength": 600 },
    "status": { "enum": ["active", "archived"] },
    "license": { "type": ["string", "null"] },
    "benchmarks": {
      "description": "Benchmark ids (data/benchmarks) this evaluator runs or tracks. Only list ids that exist in this repo.",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "methodology": {
      "description": "How scores are produced.",
      "enum": ["self-run", "crowdsourced", "submission", "collected"]
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "website": { "type": ["string", "null"], "format": "uri" },
        "repo": { "type": ["string", "null"], "format": "uri" },
        "paper": { "type": ["string", "null"], "format": "uri" }
      },
      "anyOf": [
        { "required": ["website"], "properties": { "website": { "type": "string" } } },
        { "required": ["repo"], "properties": { "repo": { "type": "string" } } }
      ]
    },
    "notes": { "type": "string", "maxLength": 800 }
  }
}
